{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "defaultLibraryPrefix": "@app",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": ".env" },
      { "include": "**/*.njk", "outDir": "./dist/src" }
    ],
    "watchAssets": true
  }
}
